{
  "name": "web-fps-rpg-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:text": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-display-texts.ps1",
    "check:wall-joins": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-wall-joins.ps1",
    "build": "npm run check:text && npm run check:wall-joins && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
