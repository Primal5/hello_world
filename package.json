{
  "name": "web-fps-rpg-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run check:utf8",
    "check:text": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-display-texts.ps1",
    "check:utf8": "node .\\scripts\\check-utf8.mjs",
    "check:item-ui-colors": "node .\\scripts\\check-item-ui-colors.mjs",
    "check:spawn-npc-placement": "node .\\scripts\\check-spawn-npc-placement.mjs",
    "check:wall-joins": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-wall-joins.ps1",
    "check:wall-overlaps": "node .\\scripts\\check-wall-overlaps.mjs",
    "check:door-clearance": "node .\\scripts\\check-door-clearance.mjs",
    "check:ui-messaging": "node .\\scripts\\check-ui-messaging.mjs",
    "build": "npm run check:text && npm run check:utf8 && npm run check:item-ui-colors && npm run check:spawn-npc-placement && npm run check:wall-joins && npm run check:wall-overlaps && npm run check:door-clearance && npm run check:ui-messaging && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
